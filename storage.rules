rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /booking-references/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.token.email == "dheeraj.rai90@gmail.com" ||
        request.auth.token.email == "komalbsc@gmail.com"
      );
    }
  }
}
